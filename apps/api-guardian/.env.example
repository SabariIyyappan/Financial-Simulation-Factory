# Copy to .env.local. The mock providers service must be running (npm run dev:providers).
MOCK_PROVIDERS_URL=http://localhost:4001

# --- Where traces/metrics/logs go ---
# You do NOT need SigNoz running on this machine. Point at whichever collector the team
# is using and everything ships there. Verify first with:
#   npx tsx scripts/check-telemetry.ts
#
# Person B's machine on the same network (ask them for their LAN IP — not localhost):
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.x.x:4318
#
# Your own local stack (npm run signoz:up):
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Keep this as api-guardian even when pointing at a shared collector — it is the same
# service, and Person B's dashboards and the evaluator's queries filter on this name.
# Runs are told apart by the factory.run_id / candidate.id span attributes, not by service.
OTEL_SERVICE_NAME=api-guardian
