{
  "name": "api-guardian",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "dev:providers": "npm run dev -w @api-guardian/mock-providers",
    "dev:app": "npm run dev -w @api-guardian/app",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "evaluate": "tsx scripts/run-evaluation.ts",
    "demo:reset": "tsx scripts/demo-control.ts reset",
    "demo:break-pricing": "tsx scripts/demo-control.ts pricing-v2"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
