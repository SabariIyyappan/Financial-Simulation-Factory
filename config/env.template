# Copy to .env at the repo root and fill in. .env is gitignored — never commit real keys.
#   cp config/env.template .env

# ---------------------------------------------------------------- Port
PORT_CLIENT_ID=your_port_client_id
PORT_CLIENT_SECRET=your_port_client_secret
PORT_API_URL=https://api.getport.io/v1
PORT_WORKSPACE_URL=https://app.getport.io

# ---------------------------------------------------------------- Bright Data
BRIGHTDATA_API_TOKEN=your_brightdata_api_token
BRIGHTDATA_API_URL=https://api.brightdata.com

# Scraper Studio collector id (c_*) from `bdata scraper create`. Self-healing preserves
# this id, so it stays valid across repairs — never create a replacement collector when
# one breaks; heal it. A new id orphans every reference to it.
BRIGHTDATA_COLLECTOR_ID=

# Web Unlocker zone name. Required for hosted extraction and the MCP server; without it
# the client runs the same selector logic locally.
BRIGHTDATA_ZONE=

# ---------------------------------------------------------------- Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------- Provider docs site
DOCS_SITE_URL=http://localhost:8001
DOCS_SITE_PORT=8001

# Public URL Bright Data's cloud uses to reach the docs site. Bright Data runs in the
# cloud and cannot see localhost, so this must be a tunnel URL at demo time. Layout
# switching still targets DOCS_SITE_URL locally.
#   cloudflared tunnel --url http://localhost:8001
DOCS_PUBLIC_URL=

# ---------------------------------------------------------------- Service endpoints
# Verified against what each service actually binds to. Change only if a port is taken.
API_GUARDIAN_URL=http://localhost:3000
PRODUCT_SNAPSHOT_ENDPOINT=/api/snapshot
MOCK_PROVIDERS_URL=http://localhost:4001
SIGNOZ_API_URL=http://localhost:8080
SIGNOZ_DASHBOARD_URL=http://localhost:8080
EVALUATOR_URL=http://localhost:8090

# ---------------------------------------------------------------- Telemetry export
# Where the app ships traces/metrics/logs. Local SigNoz by default; point at a tunnel or
# another machine's collector if SigNoz runs elsewhere.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=api-guardian

# ---------------------------------------------------------------- Factory
FACTORY_RUN_ID_PREFIX=RUN
CANDIDATE_ID_PREFIX=CANDIDATE
MAX_RETRY_ATTEMPTS=1

# ---------------------------------------------------------------- Fitness function
CORRECTNESS_WEIGHT=40
RELIABILITY_WEIGHT=20
LATENCY_WEIGHT=20
DATA_PIPELINE_WEIGHT=10
OBSERVABILITY_WEIGHT=10
PASSING_SCORE=90
P95_LATENCY_THRESHOLD_FULL_SCORE=1600
P95_LATENCY_THRESHOLD_PARTIAL_SCORE=2200
ERROR_RATE_THRESHOLD=0.01

# ---------------------------------------------------------------- Demo control
DEMO_MODE=false

# Keep false. Auto-approving removes the human gate, which is the specific thing the
# judging criteria single out ("keep humans in control where it matters").
AUTO_APPROVE=false

# Keep false for any demo. The mock returns fixture scores keyed on scenario name rather
# than measuring anything — useful only for exercising control flow offline.
USE_MOCK_EVALUATOR=false
