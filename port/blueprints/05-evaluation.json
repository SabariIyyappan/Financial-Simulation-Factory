{
  "identifier": "evaluation",
  "title": "Evaluation",
  "icon": "Check",
  "schema": {
    "properties": {
      "score": { "type": "number", "title": "Score", "minimum": 0, "maximum": 100 },
      "decision": {
        "type": "string",
        "title": "Decision",
        "enum": ["PASS", "FAIL"],
        "enumColors": { "PASS": "green", "FAIL": "red" }
      },
      "correctnessStatus": {
        "type": "string",
        "title": "Correctness",
        "enum": ["PASS", "FAIL"],
        "enumColors": { "PASS": "green", "FAIL": "red" }
      },
      "p50LatencyMs": { "type": "number", "title": "p50 latency (ms)" },
      "p95LatencyMs": { "type": "number", "title": "p95 latency (ms)" },
      "errorRate": { "type": "number", "title": "Error rate" },
      "failedProvider": { "type": "string", "title": "Failed provider" },
      "failureReason": { "type": "string", "title": "Failure reason" },
      "representativeTraceId": {
        "type": "string",
        "title": "Representative trace ID",
        "description": "SigNoz trace showing the behaviour this evaluation is based on."
      },
      "testsPassed": { "type": "number", "title": "Tests passed" },
      "testsFailed": { "type": "number", "title": "Tests failed" },
      "observabilityComplete": { "type": "boolean", "title": "Observability complete" },
      "evaluatedAt": { "type": "string", "title": "Evaluated at", "format": "date-time" }
    },
    "required": ["score", "decision"]
  },
  "relations": {
    "candidate": {
      "title": "Candidate",
      "target": "candidateVersion",
      "required": true,
      "many": false
    }
  }
}
