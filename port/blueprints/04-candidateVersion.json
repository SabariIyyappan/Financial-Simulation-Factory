{
  "identifier": "candidateVersion",
  "title": "Candidate Version",
  "icon": "Git",
  "schema": {
    "properties": {
      "hypothesis": {
        "type": "string",
        "title": "Hypothesis / plan",
        "description": "What the agent believes is wrong and the smallest change proposed to fix it."
      },
      "commitRef": { "type": "string", "title": "Commit / reference" },
      "status": {
        "type": "string",
        "title": "Lifecycle status",
        "enum": [
          "DETECTED",
          "INVESTIGATING",
          "PLANNED",
          "IMPLEMENTED",
          "EVALUATING",
          "REJECTED",
          "READY_FOR_APPROVAL",
          "APPROVED",
          "RELEASED"
        ],
        "enumColors": {
          "DETECTED": "lightGray",
          "INVESTIGATING": "blue",
          "PLANNED": "blue",
          "IMPLEMENTED": "purple",
          "EVALUATING": "yellow",
          "REJECTED": "red",
          "READY_FOR_APPROVAL": "orange",
          "APPROVED": "green",
          "RELEASED": "green"
        }
      },
      "score": { "type": "number", "title": "Fitness score", "minimum": 0, "maximum": 100 },
      "decision": {
        "type": "string",
        "title": "Objective decision",
        "enum": ["PASS", "FAIL", "PENDING"],
        "enumColors": { "PASS": "green", "FAIL": "red", "PENDING": "lightGray" }
      }
    },
    "required": ["status"]
  },
  "relations": {
    "run": { "title": "Factory run", "target": "factoryRun", "required": true, "many": false },
    "parent": {
      "title": "Parent candidate",
      "description": "Previous candidate this one was derived from — gives the lineage chain.",
      "target": "candidateVersion",
      "required": false,
      "many": false
    }
  }
}
