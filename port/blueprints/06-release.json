{
  "identifier": "release",
  "title": "Release",
  "icon": "Rocket",
  "schema": {
    "properties": {
      "version": { "type": "string", "title": "Version" },
      "approvedBy": {
        "type": "string",
        "title": "Approved by",
        "description": "Human who approved. Agents must never populate this — it is the audit record that a person authorised the release."
      },
      "approvedAt": { "type": "string", "title": "Approved at", "format": "date-time" },
      "score": { "type": "number", "title": "Score at release", "minimum": 0, "maximum": 100 },
      "status": {
        "type": "string",
        "title": "Release status",
        "enum": ["pending_approval", "released", "rolled_back"],
        "enumColors": { "pending_approval": "orange", "released": "green", "rolled_back": "red" }
      }
    },
    "required": ["version", "status"]
  },
  "relations": {
    "candidate": {
      "title": "Candidate",
      "target": "candidateVersion",
      "required": true,
      "many": false
    },
    "service": { "title": "Service", "target": "service", "required": true, "many": false }
  }
}
